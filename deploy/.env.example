# Django и базовые настройки
DJANGO_SECRET_KEY=***

# Ключи шифрования полей (TOTP и коды ссылок активации/восстановления)
# Формат: первый ключ шифрует, остальные расшифровывают
# Смена ключа: новый ключ ставится первым, затем python manage.py rotate_field_keys
FIELD_ENCRYPTION_KEYS=***

# Секрет для HMAC резервных кодов второго фактора
BACKUP_CODE_PEPPER=***

# Пароли ролей базы: читает deploy/postgres-init/01-roles.sh при первом запуске
# контейнера postgres (суперпользователь postgres, роли crm_owner и crm_app).
# Те же пароли стоят в DATABASE_URL и DATABASE_MIGRATE_URL ниже.
POSTGRES_PASSWORD=***
CRM_OWNER_PASSWORD=***
CRM_APP_PASSWORD=***

# Подключение к базе данных для работы приложения (роль crm_app)
DATABASE_URL=postgresql://crm_app:***@postgres:5432/crm

# Подключение к базе данных для миграций (роль crm_owner, только для миграций)
DATABASE_MIGRATE_URL=postgresql://crm_owner:***@postgres:5432/crm

# Пул соединений psycopg (1 — включён). Службе web docker-compose.yml задаёт 1
# сам (блок environment сильнее этого файла); worker и scheduler — без пула.
DATABASE_POOL=0
# Ожидание свободного соединения пула, секунд (только при DATABASE_POOL=1). Службе
# web-heavy docker-compose.yml задаёт 70 сама; без значения — 30 по умолчанию psycopg.
# DATABASE_POOL_TIMEOUT=70

# Подключение к Valkey для кэша, сессий и счётчиков блокировки
VALKEY_URL=redis://valkey:6379/0

# Адрес портала (используется для ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, ссылок в письмах)
PORTAL_URL=https://127.0.0.1:8031

# Адреса доверенных прокси (адреса и сети CIDR через запятую; необходимо для правильного
# определения IP клиента за прокси). Здесь — прокси администратора; внутреннюю сеть compose
# (CRM_SUBNET, там стоит nginx портала) docker-compose.yml добавляет сам.
TRUSTED_PROXIES=127.0.0.1

# Параметры развёртывания (docker-compose.yml; значения по умолчанию подходят стенду)
# MTU сети compose: 1500; на машине разработки за VPN — 1360
DOCKER_MTU=1500
# Установка за прокси администратора: NGINX_CONF=./nginx.prod.conf, NGINX_PORT=8080,
# NGINX_HEALTH_URL=http://127.0.0.1:8080/health/

# SMTP настройки для исходящих писем
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Способ защиты подключения: starttls, ssl или none
SMTP_SECURITY=none

# Антивирус ClamAV (значения по умолчанию подходят стенду)
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT=120

# Ящик заявок сервис-деска (IMAP). Пустой IMAP_HOST — приём писем выключен.
# На стенде значения вносит `python3 tools/make_dev_env.py` (режим --add-missing дописывает их в старый .env).
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# Способ защиты подключения: ssl (по умолчанию), starttls или none (none — только стенд)
# IMAP_SECURITY=ssl
# IMAP_USER=tickets
IMAP_PASSWORD=***
# IMAP_FOLDER=INBOX
# IMAP_TIMEOUT=30
# SERVICEDESK_MAILBOX=tickets@example.com

# Уведомления (срез 004, PLAN-004 «Запуск»). Пустой токен или ключ — канал выключен.
# На стенде значения вносит `python3 tools/make_dev_env.py`.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
# Пара ключей VAPID создаётся командой `manage.py notify_vapid_keys`; после выпуска пару не менять
VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# Контакт отправителя: mailto: или https:
# VAPID_SUBJECT=mailto:it@example.com
# TELEGRAM_API_BASE=https://api.telegram.org
# MAX_API_BASE=https://platform-api2.max.ru
# Узлы, куда разрешено отправлять Web Push, через запятую
# WEBPUSH_ALLOWED_HOSTS=fcm.googleapis.com,jmt17.google.com,*.notify.windows.com,updates.push.services.mozilla.com
