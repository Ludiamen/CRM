# Django и базовые настройки
DJANGO_SECRET_KEY=***

# Ключи шифрования полей (TOTP и коды ссылок активации/восстановления)
# Формат: первый ключ шифрует, остальные расшифровывают
# Смена ключа: новый ключ ставится первым, затем python manage.py rotate_field_keys
FIELD_ENCRYPTION_KEYS=***

# Секрет для HMAC резервных кодов второго фактора
BACKUP_CODE_PEPPER=***

# Пароли ролей базы: читает deploy/postgres-init/01-roles.sh при первом запуске
# контейнера postgres (суперпользователь postgres, роли crm_owner и crm_app).
# Те же пароли стоят в DATABASE_URL и DATABASE_MIGRATE_URL ниже.
POSTGRES_PASSWORD=***
CRM_OWNER_PASSWORD=***
CRM_APP_PASSWORD=***

# Подключение к базе данных для работы приложения (роль crm_app)
DATABASE_URL=postgresql://crm_app:***@postgres:5432/crm

# Подключение к базе данных для миграций (роль crm_owner, только для миграций)
DATABASE_MIGRATE_URL=postgresql://crm_owner:***@postgres:5432/crm

# Подключение к Valkey для кэша, сессий и счётчиков блокировки
VALKEY_URL=redis://valkey:6379/0

# Адрес портала (используется для ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, ссылок в письмах)
PORTAL_URL=https://127.0.0.1:8031

# Адреса доверенных прокси (через запятую; необходимо для правильного определения IP клиента за прокси)
TRUSTED_PROXIES=127.0.0.1

# SMTP настройки для исходящих писем
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Способ защиты подключения: starttls, ssl или none
SMTP_SECURITY=none
